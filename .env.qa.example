# QA defaults for local end-to-end testing (copy to .env or let qa-console create it).
SERVER_IP=auto
SERVER_IP_MODE=public
SERVER_TITLE="Dune QA Server"
SERVER_REGION="Europe Test"
SERVER_PROVIDER="dune-docker"
STEAM_APP_ID=4754530
BATTLEGROUP_ID=

# Required for qa-console up / wait-ready (never commit the token):
#   export DUNE_QA_FUNCOM_TOKEN="<token>"
# If runtime/secrets/funcom-token.txt is missing, qa-console writes it from that env var.

ADMIN_BIND_HOST=0.0.0.0
ADMIN_AUTH_DISABLED=0
ADMIN_SECURE_COOKIES=0
ADMIN_MOCK_MODE=0
ALLOW_HOST_BOOTSTRAP=false
